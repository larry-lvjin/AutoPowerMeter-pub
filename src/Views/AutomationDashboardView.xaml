<UserControl x:Class="AutoPowerMeter.Views.AutomationDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:AutoPowerMeter.Models"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             FontFamily="Microsoft YaHei UI" FontSize="12">
    <UserControl.Resources>
        <SolidColorBrush x:Key="Muted" Color="#AAB4C5" />
        <SolidColorBrush x:Key="Accent" Color="#7FB4FF" />
        <SolidColorBrush x:Key="Success" Color="#68E6A5" />
        <LinearGradientBrush x:Key="HeroGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#126F9B" Offset="0" />
            <GradientStop Color="#287B8C" Offset="0.48" />
            <GradientStop Color="#4B3B8F" Offset="1" />
        </LinearGradientBrush>

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="ActionButton" TargetType="ui:Button">
            <Setter Property="MinWidth" Value="82" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0 0 7 0" />
            <Setter Property="Padding" Value="11 6" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ui:Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.86" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StartAction" TargetType="ui:Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#20A75A" />
        </Style>
        <Style x:Key="PauseAction" TargetType="ui:Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#BD780B" />
        </Style>
        <Style x:Key="SkipAction" TargetType="ui:Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#3275CB" />
        </Style>
        <Style x:Key="StopAction" TargetType="ui:Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#C3445B" />
        </Style>
        <Style x:Key="ExportAction" TargetType="ui:Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#7250BE" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style x:Key="QueueGrid" TargetType="DataGrid">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#F2F4F8" />
            <Setter Property="RowBackground" Value="Transparent" />
            <Setter Property="AlternatingRowBackground" Value="#171B23" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#303642" />
            <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
            <Setter Property="MinRowHeight" Value="54" />
            <Setter Property="ColumnHeaderHeight" Value="34" />
        </Style>
        <Style x:Key="QueueHeader" TargetType="DataGridColumnHeader">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="#222733" />
            <Setter Property="Foreground" Value="#BFCBE0" />
            <Setter Property="BorderThickness" Value="0 0 0 1" />
            <Setter Property="BorderBrush" Value="#394252" />
            <Setter Property="Padding" Value="7 0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="LeftQueueHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource QueueHeader}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="10 0" />
        </Style>
        <Style x:Key="QueueCell" TargetType="DataGridCell">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6 2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="QueueCellText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="FullCaseCellText" TargetType="TextBlock" BasedOn="{StaticResource QueueCellText}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="None" />
            <Setter Property="LineHeight" Value="18" />
            <Setter Property="Margin" Value="2 5" />
        </Style>
        <Style x:Key="CenteredCellText" TargetType="TextBlock" BasedOn="{StaticResource QueueCellText}">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
        <Style x:Key="CaseIdentityCellText" TargetType="TextBlock" BasedOn="{StaticResource QueueCellText}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="None" />
            <Setter Property="LineHeight" Value="18" />
            <Setter Property="Margin" Value="1 5" />
        </Style>
        <Style x:Key="StatusCellText" TargetType="TextBlock" BasedOn="{StaticResource CenteredCellText}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ResultStatus.Pass}">
                    <Setter Property="Foreground" Value="#24C875" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ResultStatus.Fail}">
                    <Setter Property="Foreground" Value="#FF5C66" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:ResultStatus.Error}">
                    <Setter Property="Foreground" Value="#FF5C66" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CompactLogItem" TargetType="ListBoxItem">
            <Setter Property="Height" Value="20" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="SectionSplitter" TargetType="GridSplitter">
            <Setter Property="Height" Value="8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ResizeDirection" Value="Rows" />
            <Setter Property="ResizeBehavior" Value="CurrentAndNext" />
            <Setter Property="ShowsPreview" Value="True" />
            <Setter Property="Cursor" Value="SizeNS" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid Background="Transparent">
                            <Border Height="1" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                    Background="#343C49" />
                            <Border Width="44" Height="3" CornerRadius="2"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Background="#697487" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0 10 0 0" DataContext="{Binding TestPlan}">
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="54" />
            <RowDefinition Height="*" MinHeight="150" />
            <RowDefinition x:Name="LogRow" Height="100" MinHeight="72" />
        </Grid.RowDefinitions>

        <Border CornerRadius="7" Background="{StaticResource HeroGradient}">
            <Grid Margin="18 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="当前项目" Foreground="#DCE9F5" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding RunningCaseTitle}" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" Margin="12 0 18 0" VerticalAlignment="Center" />
                <Border Grid.Column="2" Background="#8EB6D0" Margin="0 11" />
                <TextBlock Grid.Column="3" Text="实时电流" Foreground="#DCE9F5"
                           Margin="18 0 10 0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="4" Text="{Binding LiveDisplay}" Foreground="#8FF0BE"
                           FontFamily="Cascadia Mono, Microsoft YaHei UI" FontSize="17" FontWeight="SemiBold"
                           MinWidth="88" TextAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="0 8 0 0" Height="46" VerticalAlignment="Top"
                Background="#20252E" BorderBrush="#343C49" BorderThickness="1" CornerRadius="8">
            <Grid Margin="10 5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="275" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="测试方案" Foreground="{StaticResource Muted}" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <ComboBox Grid.Column="2" Height="34" Padding="9 4" FontSize="12"
                          ItemsSource="{Binding TestSuites}"
                          SelectedItem="{Binding SelectedSuite, Mode=TwoWay}"
                          DisplayMemberPath="DisplayName"
                          ToolTip="{Binding SelectedSuite.FilePath}"
                          AutomationProperties.Name="选择整套测试方案" />
                <Grid Grid.Column="3" Margin="14 0 10 0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="FAIL 波形目录" Foreground="{StaticResource Muted}"
                               Margin="0 0 7 0" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Height="32" MinWidth="150" Padding="8 4"
                             FontFamily="Cascadia Mono, Microsoft YaHei UI" FontSize="11"
                             Background="#171B23" Foreground="#E6EDF7" BorderBrush="#424B59"
                             Text="{Binding FailWaveformDirectory, Mode=TwoWay, UpdateSourceTrigger=LostFocus, ValidatesOnExceptions=True}"
                             ToolTip="日志和Excel报告自动保存在此目录；仅FAIL保存波形。更改目录后同步当前日志和报告，保留旧文件。" />
                    <ui:Button Grid.Column="2" Content="浏览…" Height="32" MinWidth="58"
                               Margin="6 0 0 0" Padding="8 4" FontSize="11"
                               Command="{Binding BrowseFailWaveformDirectoryCommand}" />
                </Grid>
                <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ui:Button Content="开始测试" Style="{StaticResource StartAction}" Command="{Binding RunCheckedCommand}" />
                    <ui:Button Content="{Binding PauseButtonText}" Style="{StaticResource PauseAction}" Command="{Binding PauseCommand}" />
                    <ui:Button Content="跳过当前" Style="{StaticResource SkipAction}" Command="{Binding SkipCommand}" />
                    <ui:Button Content="终止批次" Style="{StaticResource StopAction}" Command="{Binding StopCommand}" />
                    <ui:Button Content="导出报告" Style="{StaticResource ExportAction}"
                               Command="{Binding ExportReportCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <ui:Card Grid.Row="2" Margin="0 8 0 0"
                 HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                 HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Padding="0">
            <Grid Margin="14 9">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="用例队列" Style="{StaticResource SectionTitle}" VerticalAlignment="Top" />
                    <TextBlock Grid.Column="1" Text="{Binding SelectionSummary}" Foreground="{StaticResource Muted}"
                               VerticalAlignment="Top" />
                </Grid>
                <DataGrid Grid.Row="1" ItemsSource="{Binding VisibleCases}"
                          SelectedItem="{Binding SelectedCase, Mode=TwoWay}"
                          Style="{StaticResource QueueGrid}" ColumnHeaderStyle="{StaticResource QueueHeader}"
                          CellStyle="{StaticResource QueueCell}"
                          SelectionMode="Extended" SelectionUnit="FullRow"
                          AutoGenerateColumns="False" CanUserAddRows="False" CanUserSortColumns="False" IsReadOnly="True" RowHeaderWidth="0"
                          HeadersVisibility="Column" EnableRowVirtualization="True" EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="62">
                            <DataGridTemplateColumn.HeaderTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding DataContext.SelectAll, RelativeSource={RelativeSource AncestorType=DataGrid}, Mode=OneWay}"
                                              Click="SelectAllCheckBox_Click"
                                              IsThreeState="False"
                                              ToolTip="全选 / 全不选"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.HeaderTemplate>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              IsEnabled="{Binding CanSelect}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="#" Binding="{Binding ExecutionOrder}" Width="54"
                                            ElementStyle="{StaticResource CenteredCellText}" />
                        <DataGridTextColumn Header="编号" Binding="{Binding Id}" Width="82"
                                            ElementStyle="{StaticResource CenteredCellText}" />
                        <DataGridTextColumn Header="类别"
                                            Binding="{Binding Category}" Width="165" MinWidth="125"
                                            HeaderStyle="{StaticResource LeftQueueHeader}"
                                            ElementStyle="{StaticResource CaseIdentityCellText}" />
                        <DataGridTextColumn Header="项目"
                                            Binding="{Binding ProjectName}" Width="255" MinWidth="175"
                                            HeaderStyle="{StaticResource LeftQueueHeader}"
                                            ElementStyle="{StaticResource CaseIdentityCellText}" />
                        <DataGridTextColumn Header="完整操作"
                                            Binding="{Binding Description}" Width="*" MinWidth="320"
                                            HeaderStyle="{StaticResource LeftQueueHeader}"
                                            ElementStyle="{StaticResource FullCaseCellText}" />
                        <DataGridTextColumn Header="状态" Binding="{Binding StatusLabel}" Width="78"
                                            ElementStyle="{StaticResource StatusCellText}" />
                        <DataGridTextColumn Header="实测" Binding="{Binding MeasuredDisplay}" Width="110"
                                            ElementStyle="{StaticResource CenteredCellText}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </ui:Card>

        <GridSplitter Grid.Row="2" Panel.ZIndex="10" Style="{StaticResource SectionSplitter}"
                      AutomationProperties.Name="调整用例队列与运行日志高度" />

        <ui:Card Grid.Row="3" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                 HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Padding="0">
            <Grid Margin="14 9">
                <Grid.RowDefinitions>
                    <RowDefinition Height="26" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="运行日志" Style="{StaticResource SectionTitle}" />
                    <ui:Button Grid.Column="1" Content="导出 TXT" Appearance="Secondary"
                               Height="26" Padding="10 2" Margin="12 -3 0 0" FontSize="12"
                               Command="{Binding DataContext.ExportLogCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                </Grid>
                <ListBox x:Name="RunLogList" Grid.Row="1"
                         ItemsSource="{Binding DataContext.Logs, RelativeSource={RelativeSource AncestorType=Window}}"
                         Background="Transparent" BorderThickness="0" FontSize="10"
                         ItemContainerStyle="{StaticResource CompactLogItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="3 0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="145" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Time, StringFormat={}{0:HH:mm:ss.fff}}"
                                           Foreground="{StaticResource Accent}" FontFamily="Cascadia Mono" />
                                <TextBlock Grid.Column="1" Text="{Binding Category}" Foreground="{StaticResource Muted}"
                                           TextTrimming="CharacterEllipsis" Margin="8 0" />
                                <TextBlock Grid.Column="2" Text="{Binding Message}" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </ui:Card>
    </Grid>
</UserControl>
